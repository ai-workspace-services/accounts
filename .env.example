# Database (local dev)
POSTGRES_USER=
POSTGRES_PASSWORD=

# Optional Supabase runtime connection URI. It overrides the file-based store.dsn.
# SUPABASE_CONNECT_URI is canonical; SUPABASE_CONNECT_URL is a compatibility alias.
SUPABASE_CONNECT_URI=
SUPABASE_CONNECT_URL=
# Generic business-layer fallback when the service is configured by env only.
DATABASE_URL=

# Internal service token (optional, used for internal APIs between services)
INTERNAL_SERVICE_TOKEN=

# SMTP (optional)
SMTP_USERNAME=
SMTP_PASSWORD=

# Stripe billing (required for checkout + portal + webhook)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Comma-separated whitelist of Stripe price ids accepted by the checkout endpoint.
# Example:
# STRIPE_ALLOWED_PRICE_IDS=price_xstream_paygo,price_xstream_subscription
STRIPE_ALLOWED_PRICE_IDS=

# OpenTelemetry OTLP Traces Ingestion (SIT / UAT / PROD Multi-Environment Routing)
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://observability.svc.plus/ingest/otlp/v1/traces
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=accounts-${RUNTIME_ENV:-prod}
OTEL_RESOURCE_ATTRIBUTES="deployment.environment=${RUNTIME_ENV:-prod},service.version=latest"
