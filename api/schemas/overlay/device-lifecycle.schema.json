{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://accounts.svc.plus/schemas/overlay/v1/device-lifecycle.schema.json",
  "title": "XConnect-One Device Lifecycle",
  "type": "object",
  "additionalProperties": false,
  "required": ["device", "duplicate"],
  "properties": {
    "revoked": {"type": "boolean"},
    "duplicate": {"type": "boolean"},
    "device": {"$ref": "#/$defs/device"},
    "policy_generation": {"type": "integer", "minimum": 1},
    "policy_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "policy_reconcile_pending": {"type": "boolean"}
  },
  "dependentRequired": {
    "policy_generation": ["policy_digest"],
    "policy_digest": ["policy_generation"]
  },
  "$defs": {
    "publicKey": {"type": "string", "pattern": "^[A-Za-z0-9+/]{43}=$"},
    "status": {"type": "string", "enum": ["active", "inactive", "revoked"]},
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "user_id", "network_id", "name", "platform", "hostname", "wireguard_public_key", "wireguard_address", "created_at", "updated_at", "last_seen_at", "status", "state_version", "key_version", "revoked_at", "revoked_reason"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "user_id": {"type": "string", "format": "uuid"},
        "network_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "maxLength": 255},
        "platform": {"type": "string", "enum": ["darwin", "windows", "linux", "ios", "android"]},
        "hostname": {"type": "string", "maxLength": 255},
        "wireguard_public_key": {"$ref": "#/$defs/publicKey"},
        "wireguard_address": {"type": "string", "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/32$"},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"},
        "last_seen_at": {"type": ["string", "null"], "format": "date-time"},
        "status": {"$ref": "#/$defs/status"},
        "state_version": {"type": "integer", "minimum": 1},
        "key_version": {"type": "integer", "minimum": 1},
        "revoked_at": {"type": ["string", "null"], "format": "date-time"},
        "revoked_reason": {"type": "string"}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "user_id", "network_id", "device_id", "type", "status", "state_version", "key_version", "created_at"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "user_id": {"type": "string", "format": "uuid"},
        "network_id": {"type": "string"},
        "device_id": {"type": "string"},
        "type": {"type": "string", "enum": ["registered", "key_rotated", "status_changed", "revoked"]},
        "status": {"$ref": "#/$defs/status"},
        "state_version": {"type": "integer", "minimum": 1},
        "key_version": {"type": "integer", "minimum": 1},
        "created_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
