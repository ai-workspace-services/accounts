{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://accounts.svc.plus/schemas/overlay/signed-config-v1.schema.json",
  "title": "XConnect-One SignedConfig v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generation", "issued_at", "expires_at", "network", "wireguard", "transport", "policy", "signature"],
  "properties": {
    "schema_version": {"const": 1},
    "generation": {"type": "integer", "minimum": 1},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "min_client_version": {"type": "string", "minLength": 1},
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "address", "dns"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "address": {"type": "string", "minLength": 1},
        "dns": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "wireguard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["peers"],
      "properties": {
        "peers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["node_id", "public_key", "allowed_ips", "endpoint"],
            "properties": {
              "node_id": {"type": "string", "minLength": 1},
              "public_key": {"type": "string", "minLength": 1},
              "allowed_ips": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
              "endpoint": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proxy_core", "type", "host", "port", "credential_ref"],
      "properties": {
        "proxy_core": {"const": "xray"},
        "type": {"const": "vless-tls-xudp"},
        "host": {"type": "string", "minLength": 1},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "credential_ref": {"type": "string", "minLength": 1}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "artifact_hash", "rules"],
      "properties": {
        "revision": {"type": "integer", "minimum": 0},
        "artifact_hash": {"type": "string", "pattern": "^sha256:"},
        "rules": {"type": "array", "items": {"type": "object"}}
      }
    },
    "signature": {"$ref": "#/$defs/signature"}
  },
  "$defs": {
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "algorithm", "value"],
      "properties": {
        "key_id": {"type": "string", "minLength": 1},
        "algorithm": {"const": "Ed25519"},
        "value": {"type": "string", "minLength": 1}
      }
    }
  }
}
