{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://accounts.svc.plus/schemas/overlay/gateway-snapshot-v1.schema.json",
  "title": "XConnect-One GatewaySnapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "node_id", "generation", "issued_at", "expires_at", "interface", "peers", "policy", "transport", "signature"],
  "properties": {
    "schema_version": {"const": 1},
    "node_id": {"type": "string", "minLength": 1},
    "generation": {"type": "integer", "minimum": 1},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "min_gateway_version": {"type": "string", "minLength": 1},
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "address", "listen_port"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "address": {"type": "string", "minLength": 1},
        "listen_port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "peers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["device_id", "public_key", "allowed_ips"],
        "properties": {
          "device_id": {"type": "string", "minLength": 1},
          "public_key": {"type": "string", "minLength": 1},
          "allowed_ips": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "artifact_hash", "rules"],
      "properties": {
        "revision": {"type": "integer", "minimum": 0},
        "artifact_hash": {"type": "string", "pattern": "^sha256:"},
        "rules": {"type": "array", "items": {"type": "object"}}
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proxy_core", "runtime_config"],
      "properties": {
        "proxy_core": {"const": "xray"},
        "runtime_config": {"type": "object"}
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "algorithm", "value"],
      "properties": {
        "key_id": {"type": "string", "minLength": 1},
        "algorithm": {"const": "Ed25519"},
        "value": {"type": "string", "minLength": 1}
      }
    }
  }
}
